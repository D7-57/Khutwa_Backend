{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12"
  },
  "buildAptPackages": [
    "libgl1",
    "libglib2.0-0",
    "libcairo2-dev",
    "pkg-config"
  ],
  "steps": {
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "python download_models.py"
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "libgl1",
      "libglib2.0-0",
      "libcairo2"
    ],
    "startCommand": "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}